{
  "name": "hermes-cockpit-tauri",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Hermes mission control client for Windows and Android",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "web:dev": "vite",
    "web:build": "vite build",
    "web:preview": "vite preview",
    "check": "node scripts/check.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk",
    "android:build:debug": "tauri android build --debug --apk",
    "icons": "tauri icon src-tauri/icons/source.png --output src-tauri/icons",
    "test": "node --test scripts/client.test.mjs scripts/release.test.mjs scripts/diagnostics.test.mjs && node scripts/test-native.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "2.5.0",
    "@tauri-apps/plugin-websocket": "2.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "ajv": "8.17.1",
    "vite": "8.3.5"
  }
}
